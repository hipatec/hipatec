# PostgreSQL local or Neon development branch
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=USER
SPRING_DATASOURCE_PASSWORD=PASSWORD

# Spring profile and HTTP
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
HIPATEC_FRONTEND_ORIGIN=http://localhost:8100
HIPATEC_RESET_URL=http://localhost:8100/redefinir-senha

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase
FIREBASE_CREDENTIALS_PATH=
FIREBASE_DATABASE_URL=

# Local email with Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
HIPATEC_MAIL_PROVIDER=smtp
HIPATEC_MAIL_FROM=nao-responda@hipatec.local

# Optional OneSignal provider
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Production SMTP option without a paid domain: Brevo Free
# Verify the sender address in Brevo before using it.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=BREVO_SMTP_LOGIN
# SMTP_PASSWORD=BREVO_SMTP_KEY
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# HIPATEC_MAIL_PROVIDER=smtp
# HIPATEC_MAIL_FROM=VERIFIED_SENDER_EMAIL
# HIPATEC_RESET_URL=https://hipatec.pages.dev/redefinir-senha

# Production Mailgun HTTP API option (preferred over SMTP when enabled)
# HIPATEC_MAIL_PROVIDER=mailgun
# MAILGUN_DOMAIN=hipatec.app
# MAILGUN_API_KEY=key-REDACTED
# MAILGUN_BASE_URL=https://api.mailgun.net/v3
# HIPATEC_MAIL_FROM=Hipatec <nao-responda@hipatec.app>

# Optional Brevo HTTP API (explicit opt-in; no SMTP credentials needed)
# HIPATEC_MAIL_PROVIDER=brevo
# BREVO_API_KEY=SET_ONLY_IN_RAILWAY_RUNTIME
# BREVO_BASE_URL=https://api.brevo.com/v3
# HIPATEC_MAIL_FROM=Hipatec <sender@verified-domain.invalid>
# HIPATEC_RESET_URL=https://frontend.invalid/redefinir-senha
# Verify sender/domain in Brevo. Free plan has a daily cap; confirm live account limits.
